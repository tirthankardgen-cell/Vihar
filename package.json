{
  "name": "vihar",
  "version": "1.0.0",
  "private": true,
  "description": "Vihar — A space to play. Original browser games, made for a little escape.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:adsense": "node --experimental-strip-types --test scripts/adsense-config.test.mjs",
    "check": "npm run lint && npm run test:adsense && npm run typecheck && npm run build",
    "assets": "node scripts/generate-assets.mjs",
    "verify": "node scripts/verify-site.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
