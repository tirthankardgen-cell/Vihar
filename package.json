{
  "name": "vihar",
  "version": "1.0.0",
  "private": true,
  "description": "Vihar \u2014 A space to play. Original browser games, made for a little escape.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:adsense": "node --experimental-strip-types --test scripts/adsense-config.test.mjs",
    "test:account": "node --experimental-strip-types --test scripts/account.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-vihar --only firestore \"node --test scripts/firestore-rules.test.mjs\"",
    "emulators": "firebase emulators:start --project demo-vihar --only auth,firestore",
    "check": "npm run lint && npm run test:adsense && npm run test:account && npm run test:community && npm run typecheck && npm run build",
    "assets:avatars": "node scripts/generate-avatars.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "verify": "node scripts/verify-site.mjs",
    "test:community": "node --experimental-strip-types --test scripts/community-public.test.mjs scripts/game-publishing.test.mjs"
  },
  "engines": {
    "node": "26.x"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "1.65.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "15.34.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
