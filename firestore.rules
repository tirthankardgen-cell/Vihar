rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function validUsername(name) {
      return name is string && name.matches('^[a-z][a-z0-9_]{2,19}$')
        && !(name in ['admin', 'administrator', 'vihar', 'support', 'system', 'moderator', 'official', 'help', 'account', 'deleted']);
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'bio', 'avatarId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'displayName', 'bio', 'avatarId', 'createdAt', 'updatedAt'])
        && data.uid == uid && validUsername(data.username)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 32
        && data.bio is string && data.bio.size() <= 160
        && data.avatarId in ['sun', 'moon', 'tiger', 'frog', 'kite', 'planet']
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    // Public identity contains no email, tokens or private account settings.
    // Exact profile links are readable; bulk profile/username enumeration is not.
    match /profiles/{uid} {
      allow get: if true;
      allow list: if false;
      allow create: if owner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if owner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'avatarId', 'updatedAt']);
      allow delete: if false;

      // Future trusted game backends publish stats here with the Admin SDK.
      // A browser cannot award itself scores, play time or achievements.
      match /stats/{gameId} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }
    match /players/{uid}/favorites/{gameId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && gameId in ['bap-ka-rasta', 'gulam-chor']
        && request.resource.data.keys().hasOnly(['addedAt']) && request.resource.data.addedAt == request.time;
      allow delete: if owner(uid);
      allow update: if false;
    }
    // Private connected-game records. All writes are validated by the server.
    match /players/{uid}/{collection}/{recordId} {
      allow read: if collection in ['gameStats', 'sessions', 'connections', 'saves'] && owner(uid);
      allow write: if false;
    }
    match /gameIntegrations/{gameId} {
      allow read: if owner(get(/databases/$(database)/documents/communityGames/$(gameId)).data.ownerId);
      allow write: if false;
    }
    // Private, immutable website opens. These are not scores or in-game sessions.
    match /players/{uid}/activity/{eventId} {
      function validGame(data) {
        return (data.source == 'officialGames'
          && ((data.gameId == 'bap-ka-rasta' && data.title == 'Bap Ka Rasta')
            || (data.gameId == 'gulam-chor' && data.title == 'Gulam Chor')))
          || (data.source == 'communityGames'
            && get(/databases/$(database)/documents/communityGames/$(data.gameId)).data.published == true
            && get(/databases/$(database)/documents/communityGames/$(data.gameId)).data.ownerId != uid
            && data.title == get(/databases/$(database)/documents/communityGames/$(data.gameId)).data.title);
      }
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['gameId', 'source', 'title', 'startedAt'])
        && request.resource.data.keys().hasOnly(['gameId', 'source', 'title', 'startedAt'])
        && request.resource.data.gameId is string && request.resource.data.gameId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.startedAt == request.time
        && validGame(request.resource.data)
        && existsAfter(/databases/$(database)/documents/$(request.resource.data.source)/$(request.resource.data.gameId)/players/$(uid));
      allow update, delete: if false;
    }
    match /friendships/{id} {
      function participant() { return signedIn() && request.auth.uid in resource.data.members; }
      // Missing documents must be readable for atomic reciprocal-request checks.
      allow get: if signedIn() && (resource == null || participant());
      allow list: if participant();
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['from', 'to', 'members', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.members == [request.auth.uid, request.resource.data.to]
        && id == request.auth.uid + '__' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to))
        && !existsAfter(/databases/$(database)/documents/friendships/$(request.resource.data.to + '__' + request.auth.uid));
      allow update: if verified() && request.auth.uid == resource.data.to
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if participant();
    }
    function validImage(url) {
      return url is string && url.size() <= 2048
        && url.matches('^https://[a-zA-Z0-9][a-zA-Z0-9.-]*[.][a-zA-Z]{2,}(/[^ ]*)?$');
    }
    function validScreenshots(images) {
      return images is list && images.size() <= 6
        && (images.size() < 1 || validImage(images[0]))
        && (images.size() < 2 || validImage(images[1]))
        && (images.size() < 3 || validImage(images[2]))
        && (images.size() < 4 || validImage(images[3]))
        && (images.size() < 5 || validImage(images[4]))
        && (images.size() < 6 || validImage(images[5]));
    }
    function validReview(data) {
      return data.keys().hasAll(['rating', 'text', 'updatedAt'])
        && data.keys().hasOnly(['rating', 'text', 'updatedAt'])
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.updatedAt == request.time;
    }
    // Curated playable game IDs; no client may create or modify official listings.
    match /officialGames/{gameId} {
      function playable() { return gameId in ['bap-ka-rasta', 'gulam-chor']; }
      allow read, write: if false;
      match /players/{uid} {
        allow read: if playable() && owner(uid);
        allow create: if playable() && owner(uid)
          && request.resource.data.keys().hasOnly(['startedAt']) && request.resource.data.startedAt == request.time;
        allow update, delete: if false;
      }
      match /reviews/{uid} {
        allow read: if playable();
        allow create, update: if playable() && owner(uid)
          && exists(/databases/$(database)/documents/officialGames/$(gameId)/players/$(uid))
          && validReview(request.resource.data);
        allow delete: if playable() && owner(uid);
      }
    }
    match /communityGames/{gameId} {
      function readyToPublish(data) {
        let integration = get(/databases/$(database)/documents/gameIntegrations/$(gameId)).data;
        return integration.enabled == true && integration.verified == true
          && integration.url == data.url && integration.authMode == data.authMode
          && data.coverUrl.size() > 0 && data.howToPlay.size() > 0;
      }
      function ownsGame() { return owner(resource.data.ownerId); }
      function published() { return resource.data.published == true; }
      function validGame(data) {
        return data.keys().hasAll(['ownerId', 'title', 'description', 'url', 'kind', 'published', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['ownerId', 'title', 'description', 'url', 'kind', 'published', 'createdAt', 'updatedAt', 'coverUrl', 'screenshots', 'howToPlay', 'controls', 'requirements', 'genre', 'authMode'])
          && (!('authMode' in data) || data.authMode in ['none', 'vihar-id'])
          && (!('coverUrl' in data) || data.coverUrl == '' || validImage(data.coverUrl))
          && (!('screenshots' in data) || validScreenshots(data.screenshots))
          && (!('howToPlay' in data) || (data.howToPlay is string && data.howToPlay.size() <= 3000))
          && (!('controls' in data) || (data.controls is string && data.controls.size() <= 1000))
          && (!('requirements' in data) || (data.requirements is string && data.requirements.size() <= 1000))
          && (!('genre' in data) || (data.genre is string && data.genre.size() <= 60))
          && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
          && data.description is string && data.description.size() >= 1 && data.description.size() <= 2000
          && data.url is string && data.url.size() <= 2048
          && data.url.matches('^https://[a-zA-Z0-9][a-zA-Z0-9.-]*[.][a-zA-Z]{2,}(/[^ ]*)?$')
          && data.kind in ['browser', 'download'] && data.published is bool && data.createdAt is timestamp && data.updatedAt == request.time;
      }
      allow read: if published() || ownsGame();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && validGame(request.resource.data) && request.resource.data.createdAt == request.time
        && request.resource.data.published == false;
      allow update: if ownsGame() && validGame(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'url', 'kind', 'published', 'updatedAt', 'coverUrl', 'screenshots', 'howToPlay', 'controls', 'requirements', 'genre', 'authMode'])
        && (request.resource.data.published == false || readyToPublish(request.resource.data));
      allow delete: if false;
      match /metrics/{id} {
        allow read: if owner(get(/databases/$(database)/documents/communityGames/$(gameId)).data.ownerId);
        allow write: if false;
      }
      match /players/{uid} {
        function game() { return get(/databases/$(database)/documents/communityGames/$(gameId)).data; }
        allow read: if owner(uid) || owner(game().ownerId);
        // One immutable launch receipt per signed-in player. No client-written counters.
        allow create: if owner(uid) && game().published == true && game().ownerId != uid
          && request.resource.data.keys().hasOnly(['startedAt']) && request.resource.data.startedAt == request.time;
        allow update, delete: if false;
      }
      match /reviews/{uid} {
        function game() { return get(/databases/$(database)/documents/communityGames/$(gameId)).data; }
        allow read: if game().published == true || owner(game().ownerId);
        allow create, update: if owner(uid) && game().published == true && game().ownerId != uid
          && exists(/databases/$(database)/documents/communityGames/$(gameId)/players/$(uid))
          && validReview(request.resource.data);
        allow delete: if owner(uid);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
