# Optional. Canonical production origin; www redirects to this address.
SITE_URL=https://vihar.online

# Optional. The game's independent deployment, verified over HTTPS.
BAP_KA_RASTA_URL=https://rasta.vihar.online
GULAM_CHOR_URL=https://gulamchor.vihar.online

# Public support address, supplied by the site owner.
SUPPORT_EMAIL=contact@vihar.online

# Public IDs, not secrets. Set in Vercel before rebuilding.
ADSENSE_PUBLISHER_ID=ca-pub-6693217545827146
GOOGLE_SITE_VERIFICATION=
# Review mode: verification meta tag and ads.txt stay available without ads.
# All three switches must be true before ads load on the completed guide only.
# Never set approval/consent confirmations just to bypass review mode.
ADSENSE_ENABLED=false
# Set only after AdSense Sites shows Ready for this domain.
ADSENSE_SITE_APPROVED=false
# Set only after publishing/testing the required certified CMP messages and
# privacy choices, and configuring Auto ads exclusions (see development.md).
ADSENSE_CONSENT_READY=false

# Firebase web configuration. Set the supplied values in Vercel before building,
# or in an ignored .env.local for development. NEXT_PUBLIC_* values are included
# in browser JavaScript; never use these variables for Admin/private keys.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional. Analytics collection is not enabled by this application.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Local testing only, with npm run emulators. Never enable on a deployment.
NEXT_PUBLIC_FIREBASE_EMULATORS=false
# Optional ports when running an isolated local emulator alongside another one.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# Server-only Vihar ID service credentials. Never use NEXT_PUBLIC_ names here.
# Set on Vercel Production too: its serverless runtime disables require(ESM)
# by default, which Firebase Admin 14's JWKS dependency needs at startup.
NODE_OPTIONS=--experimental-require-module
# Production service account needs roles/datastore.user and roles/firebaseauth.viewer.
# Set these as encrypted Production variables in the existing Vercel project.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# PEM key; escaped \n line breaks are supported. Never commit a real key.
FIREBASE_ADMIN_PRIVATE_KEY=
# Local API tests only. Must remain false/unset on Vercel.
VIHAR_ID_EMULATOR=false
# With VIHAR_ID_EMULATOR=true, also set these for the server process:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Public Bing Webmaster Tools msvalidate.01 value; not a password or API key.
BING_SITE_VERIFICATION=
# Domain migration: first connect vihar.online directly to Production in Vercel,
# redirect www to it, and authorize vihar.online in Firebase Auth.
# Then set SITE_URL=https://vihar.online and redeploy.
