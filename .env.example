# Optional. Matches the existing Vercel redirect from vihar.online to www.
SITE_URL=https://www.vihar.online

# Optional. The game's independent deployment, verified over HTTPS.
BAP_KA_RASTA_URL=https://rasta.vihar.online

# Public support address, supplied by the site owner.
SUPPORT_EMAIL=contact@vihar.online

# Public IDs, not secrets. Set in Vercel before rebuilding.
ADSENSE_PUBLISHER_ID=ca-pub-6693217545827146
GOOGLE_SITE_VERIFICATION=
# Review mode: verification meta tag and ads.txt stay available without ads.
# All three switches must be true before ads load on the completed guide only.
# Never set approval/consent confirmations just to bypass review mode.
ADSENSE_ENABLED=false
# Set only after AdSense Sites shows Ready for this domain.
ADSENSE_SITE_APPROVED=false
# Set only after publishing/testing the required certified CMP messages and
# privacy choices, and configuring Auto ads exclusions (see development.md).
ADSENSE_CONSENT_READY=false
